-- ==========================================
-- 🔍 4. ฟังก์ชันหาเป้าหมาย (Get Target)
-- ==========================================
local function GetTarget()
    Cam = workspace.CurrentCamera
    if not Cam or not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then 
        return nil 
    end
    
    local Center = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)
    local MyPos = LocalPlayer.Character.HumanoidRootPart.Position
    local BestTarget, BestDist = nil, Settings.FOVRadius
    
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    
    for _, Plr in pairs(Players:GetPlayers()) do
        if Plr ~= LocalPlayer and Plr.Character 
        and Plr.Character:FindFirstChild(Settings.AimPart)
        and Plr.Character:FindFirstChild("Humanoid")
        and Plr.Character.Humanoid.Health > 0 then
            
            local TargetPart = Plr.Character[Settings.AimPart]
            local Pos, Visible = Cam:WorldToViewportPoint(TargetPart.Position)
            
            if Visible then
                local Dist = (Vector2.new(Pos.X, Pos.Y) - Center).Magnitude
                if Dist < BestDist then
                    local Dir = (TargetPart.Position - MyPos).Unit
                    local Dis = (TargetPart.Position - MyPos).Magnitude
                    
                    if Dis <= Settings.ShootRange then
                        local Ray = workspace:Raycast(MyPos, Dir * Dis, rayParams)
                        if not Ray or Ray.Instance:IsDescendantOf(Plr.Character) then
                            BestDist = Dist
                            BestTarget = TargetPart
                        end
                    end
                end
            end
        end
    end
    return BestTarget
end

-- ==========================================
-- 👁️ 5. ระบบ ESP (BillboardGui & Drawing API)
-- ==========================================
local ESP_Objects = {}
local TextLabels = {}

local function RemoveESP(Player)
    if ESP_Objects[Player] and ESP_Objects[Player].Gui then
        ESP_Objects[Player].Gui:Destroy()
        ESP_Objects[Player] = nil
    end
    if TextLabels[Player.UserId] then
        TextLabels[Player.UserId]:Remove()
        TextLabels[Player.UserId] = nil
    end
end

local function CreateESP(Player)
    if Player == LocalPlayer then return end

    local function SetupCharacter(char)
        local head = char:WaitForChild("Head", 5)
        if not head then return end

        RemoveESP(Player)

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "ESP_Name"
        billboard.Adornee = head
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.StudsOffset = Vector3.new(0, 2, 0)
        billboard.AlwaysOnTop = true

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.TextStrokeTransparency = 0
        label.TextSize = 14
        label.Font = Enum.Font.SourceSansBold
        label.Parent = billboard

        billboard.Parent = head
        ESP_Objects[Player] = { Gui = billboard, Label = label }
    end

    if Player.Character then SetupCharacter(Player.Character) end
    Player.CharacterAdded:Connect(SetupCharacter)

    if Drawing then
        local Draw = Drawing.new("Text")
        Draw.Center = true
        Draw.Outline = true
        Draw.Font = 2
        Draw.Size = 13
        Draw.Color = Color3.fromRGB(255, 220, 80)
        Draw.Visible = false
        TextLabels[Player.UserId] = Draw
    end
end

for _, P in pairs(Players:GetPlayers()) do CreateESP(P) end
Players.PlayerAdded:Connect(CreateESP)
Players.PlayerRemoving:Connect(RemoveESP)

local function GetHeldItem(Character)
    if not Character then return nil end
    local Tool = Character:FindFirstChildOfClass("Tool")
    return Tool and ("🎒 " .. Tool.Name) or nil
end

