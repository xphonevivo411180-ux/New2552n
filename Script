-- 🔄 8. Main Loop (RenderStepped)
-- ==========================================
RunService.RenderStepped:Connect(function()
    Cam = workspace.CurrentCamera
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")

    if Settings.AimEnabled then
        local Target = GetTarget()
        if Target and Cam then
            Cam.CFrame = CFrame.new(Cam.CFrame.Position, Target.Position)
        end
    end

    for player, esp in pairs(ESP_Objects) do
        local char = player.Character
        local hum = char and char:FindFirstChild("Humanoid")
        local head = char and char:FindFirstChild("Head")

        if Settings.EspEnabled and myHRP and char and head and hum and hum.Health > 0 then
            local dist = math.floor((myHRP.Position - head.Position).Magnitude)
            esp.Label.Text = player.Name .. " [" .. dist .. "m]"
            esp.Gui.Enabled = true
        else
            if esp.Gui then esp.Gui.Enabled = false end
        end
    end

    if Drawing then
        for _, Plr in pairs(Players:GetPlayers()) do
            if Plr ~= LocalPlayer then
                local Draw = TextLabels[Plr.UserId]
                if Draw then
                    local char = Plr.Character
                    local head = char and char:FindFirstChild("Head")
                    local hum = char and char:FindFirstChild("Humanoid")

                    if Settings.ItemEspEnabled and head and hum and hum.Health > 0 and Cam then
                        local Pos, Visible = Cam:WorldToViewportPoint(head.Position + Vector3.new(0, 1.5, 0))
                        local Item = GetHeldItem(char)

                        if Visible and Item then
                            Draw.Visible = true
                            Draw.Position = Vector2.new(Pos.X, Pos.Y)
                            Draw.Text = Item
                        else
                            Draw.Visible = false
                        end
                    else
                        Draw.Visible = false
                    end
                end
            end
        end
    end
end)

